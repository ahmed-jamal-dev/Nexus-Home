# Nexus Home Database Environment Configuration
# Copy this file to .env and set a strong password
# NEVER commit .env with real credentials

# Required: PostgreSQL password (compose will fail if missing)
POSTGRES_PASSWORD=

# Optional: Database connection string for API (uses above password)
# ConnectionStrings__NexusHome=Host=localhost;Port=5432;Database=nexus_home;Username=nexus;Password=${POSTGRES_PASSWORD};Include Error Detail=true